{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ManifestCoreTests",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/build/ManifestCoreTests",
            "arguments": "${workspaceFolder}/data/core-config/ages.yaml ${workspaceFolder}/data/core-config/categories.yaml ${workspaceFolder}/data/core-config/full.yaml",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "gdbpath": "${workspaceFolder}/.devenv/profile/bin/gdb",
            "valuesFormatting": "prettyPrinters"
        }
    ]
}
